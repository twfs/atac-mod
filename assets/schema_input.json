{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/atacseq/master/assets/schema_input.json",
    "title": "nf-core/atacseq pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "fastq_1": {
                "errorMessage": "FastQ file for reads 1 cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'. Leave empty when the row provides a 'bam' instead.",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.f(ast)?q\\.gz$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "fastq_2": {
                "errorMessage": "FastQ file for reads 2 cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.f(ast)?q\\.gz$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "replicate": {
                "type": "integer",
                "pattern": "^[1-9][0-9]*$",
                "errorMessage": "Integer representing replicate number. Must start from 1..<number of replicates>."
            },
            "bam": {
                "errorMessage": "BAM file cannot contain spaces and must have extension '.bam'",
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.bam$"
                    },
                    {
                        "type": "string",
                        "maxLength": 0
                    }
                ]
            },
            "control": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Control entry cannot contain spaces"
            },
            "control_replicate": {
                "type": "integer",
                "pattern": "^[1-9][0-9]*$",
                "errorMessage": "Integer representing control's replicate number."
            }
        },
        "required": [
            "sample",
            "replicate"
        ],
        "anyOf": [
            {
                "required": [
                    "fastq_1"
                ]
            },
            {
                "required": [
                    "bam"
                ]
            }
        ]
    }
}
